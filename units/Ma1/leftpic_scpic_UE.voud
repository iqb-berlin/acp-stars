{
  "id": "stars-unit-definition",
  "version": "0.15",
  "backgroundColor": "#B1DFFF",
  "ribbonBars": true,
  "firstAudioOptions": {
    "firstClickLayer": "TRANSPARENT",
    "animateButton": "BOLD"
  },
  "continueButtonShow": "ON_AUDIO_AND_RESPONSE",
  "mainAudio": {
    "audioSource":  "data:audio/mpeg;base64,",
    "maxPlay": 3,
    "disableInteractionUntilComplete": false
  },
  "interactionType": "BUTTONS",
  "interactionParameters": {
    "variableId": "interact",
    "imageSource":  "data:image/png;base64,",
    "imagePosition": "LEFT",
    "layout": "LEFT_BOTTOM",
    "imageUseFullArea": false,
    "buttonType": "TALL_RECTANGLE",
    "multiSelect": false,
    "numberOfRows": 1,
    "options": {
      "buttons": [
        {
          "imageSource":  "data:image/webp;base64,"
        },
        {
          "imageSource":  "data:image/webp;base64,"
        },
        {
          "imageSource":  "data:image/webp;base64,"
        },
        {
          "imageSource":  "data:image/webp;base64,"
        },
        {
          "imageSource":  "data:image/webp;base64,"
        },
        {
          "imageSource":  "data:image/webp;base64,"
        },
        {
          "imageSource":  "data:image/webp;base64,"
        }
      ]
    }
  },
  "variableInfo": [
    {
      "variableId": "interact",
      "responseComplete": "ON_ANY_RESPONSE",
      "codingSource": "VALUE",
      "codes": [
        {
          "method": "EQUALS",
          "parameter": "4",
          "code": 1,
          "score": 1
        }
      ]
    }
  ],
  "audioFeedback": {
    "trigger": "CONTINUE_BUTTON_CLICK",
    "feedback": [
      {
        "variableId": "interact",
       "audioSource":  "data:audio/mpeg;base64,",
        "source": "CODE",
        "method": "EQUALS",
        "parameter": "1"
      },
      {
        "variableId": "interact",
        "audioSource":  "data:audio/mpeg;base64,",
        "source": "CODE",
        "method": "EQUALS",
        "parameter": "0",
        "showResponse": {
          "variableId": "interact",
          "value": "4",
          "delayMS": 4200
        }
}
    ]
  }
}