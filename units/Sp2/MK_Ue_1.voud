{ 
  "id": "stars-unit-definition",
  "version": "0.7",
  "backgroundColor": "#FFD4AC",
  "ribbonBars": true,
  "firstAudioOptions": {
    "firstClickLayer": "TRANSPARENT",
    "animateButton": "BOLD"
  },
  "continueButtonShow": "ON_AUDIO_AND_RESPONSE",
  "mainAudio": {
    "audioSource":  "data:audio/mpeg;base64,",
    "maxPlay": 3,
    "disableInteractionUntilComplete": false
  },
  "interactionType": "BUTTONS",
  "interactionParameters": {
    "variableId": "interact",
    "buttonType": "MEDIUM_SQUARE",
    "multiSelect": false,
    "triggerNavigationOnSelect": false,
    "numberOfRows": 1,
    "options": {
      "buttons": [
        {
                      "imageSource":  "data:image/png;base64,",
                      "filename":  "601_Seestern_Smiley_negativnegativ_350.png"
                  }, 
{
                      "imageSource":  "data:image/png;base64,",
                      "filename":  "602_Seestern_Smiley_negativ_350.png"
                  },
                                                            {
                      "imageSource":  "data:image/png;base64,",
                      "filename":  "603_Seestern_Smiley_positiv_350.png"
                  },
                                                             {
                      "imageSource":  "data:image/png;base64,",
                      "filename":  "604_Seestern_Smiley_positivpositiv_350.png"
                  }
      ]
    }
  },
  "audioFeedback": {
    "trigger": "CONTINUE_BUTTON_CLICK",
    "feedback": [
      {
        "variableId": "interact",
       "audioSource":  "data:audio/mpeg;base64,",
        "source": "VALUE",
        "method": "LESS_THAN",
        "parameter": "3"
      },
      {
        "variableId": "interact",
       "audioSource":  "data:audio/mpeg;base64,",
        "source": "VALUE",
        "method": "GREATER_THAN",
        "parameter": "2"
      }
    ]
  }

}