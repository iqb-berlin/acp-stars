{
  "id": "stars-unit-definition",
  "version": "0.7",
  "backgroundColor": "#E1E9FF",
  "ribbonBars": true,
  "firstAudioOptions": {
    "firstClickLayer": "DISABLED",
    "animateButton": "BOLD"
  },
  "continueButtonShow": "ON_ANY_RESPONSE",
  "mainAudio": {
    "audioSource":  "data:audio/mpeg;base64,",
    "maxPlay": 3,
    "disableInteractionUntilComplete": false
  },
   "interactionType": "WRITE",
  "interactionParameters": {
    "variableId": "interact",
    "imageSource":  "data:image/webp;base64,",
    "addBackspaceKey": true,
    "keyboardMode": "NUMBERS_LINE",
    "maxInputLength": 2
  },
  "variableInfo": [
    {
      "variableId": "interact",
      "responseComplete": "ON_FULL_CREDIT",
      "codes": [
        {
          "method": "EQUALS",
          "parameter": "13",
          "code": 1,
          "score": 1
        }
      ]
    }
  ],
  "audioFeedback": {
    "trigger": "CONTINUE_BUTTON_CLICK",
    "feedback": [
      {
        "variableId": "interact",
       "audioSource":  "data:audio/mpeg;base64,",
        "source": "CODE",
        "method": "EQUALS",
        "parameter": "1"
      },
      {
        "variableId": "interact",
        "audioSource":  "data:audio/mpeg;base64,",
        "source": "CODE",
        "method": "EQUALS",
        "parameter": "0",
        "showResponse": {
          "variableId": "interact",
          "value": "13",
          "delayMS": 1000
        }
}
    ]
  }
}