{
  "id": "stars-unit-definition",
  "version": "0.7",
  "backgroundColor": "#DBFFAC",
  "ribbonBars": true,
  "firstAudioOptions": {
    "firstClickLayer": "TRANSPARENT",
    "animateButton": "BOLD"
  },
  "continueButtonShow": "ON_ANY_RESPONSE",
  "mainAudio": {
    "audioSource":"data:audio/mpeg;base64,",
    "maxPlay": 3,
    "disableInteractionUntilComplete": false
  },
  "interactionType": "DROP",
  "interactionParameters": {
    "variableId": "interact",
    "imageSource":  "data:image/webp;base64,",
    "imagePosition": "BOTTOM",
    "imageLandingXY": "50,45",
    "options": 
       [
                  {
                      "imageSource":  "data:image/webp;base64,"
                  },
                  {
                      "imageSource":  "data:image/webp;base64,"
                  },
                  {
                      "imageSource":  "data:image/webp;base64,"
                  },
                  {
                      "imageSource":  "data:image/webp;base64,"
                  }
      ]
  },

    "variableInfo": [
        {
            "variableId": "interact",
            "responseComplete": "ON_ANY_RESPONSE",
            "codingSource": "VALUE",
            "codes": [
                {
                    "method": "EQUALS",
                    "parameter": "1",
                    "code": 1,
                    "score": 1
                }
            ]
        }
    ],
  "audioFeedback": {
    "trigger": "CONTINUE_BUTTON_CLICK",
    "feedback": [
      {
        "variableId": "interact",
        "audioSource": "data:audio/mpeg;base64,",
        "source": "CODE",
        "method": "EQUALS",
        "parameter": "1"
      },
      {
        "variableId": "interact",
        "audioSource": "data:audio/mpeg;base64,",
        "source": "CODE",
        "method": "EQUALS",
        "parameter": "0",
        "showResponse": {
          "variableId": "interact",
          "value": "1",
          "delayMS": 1000
        }
}
    ]
  }
}